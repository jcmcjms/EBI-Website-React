// =====================================================================
// EBI Website — Prisma schema (development / SQLite).
//
// Production override: see `schema.production.prisma` (sqlserver).
// The two files are kept in sync by the developer; `migrate deploy`
// in prod points at the prod schema file.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------
// NOTE: SQLite has no native enum type. Prisma represents these as
// TEXT columns in the generated migration. The SQL Server
// (`schema.production.prisma`) variant uses real enums.

enum UserRole {
  EDITOR
  PUBLISHER
  ADMIN
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum MediaFormat {
  WEBP
  AVIF
  JPEG
}

// ------------------------------------------------------------------------
// User
// ------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?  // bcrypt; null when SSO-only
  role         UserRole @default(EDITOR)
  mfaSecret    String?  // base32 TOTP secret (TASK-12)

  createdAt    DateTime @default(now())

  authoredPages   Page[]          @relation("PageAuthor")
  updatedSections Section[]       @relation("SectionUpdater")
  uploadedMedia   MediaAsset[]    @relation("MediaUploader")
  newsArticles    NewsArticle[]   @relation("NewsAuthor")
  auditLogs       AuditLog[]      @relation("AuditActor")
}

// ------------------------------------------------------------------------
// Page — CMS-managed page; sections hang off it as a one-to-many.
// ------------------------------------------------------------------------

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  seoTitle        String
  metaDescription String
  ogImageId       String?
  ogImage         MediaAsset? @relation("PageOgImage", fields: [ogImageId], references: [id])
  status          PageStatus @default(DRAFT)
  sections        Section[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  authorId        String?
  author          User?      @relation("PageAuthor", fields: [authorId], references: [id])

  @@index([status])
}

// ------------------------------------------------------------------------
// Section — typed JSON payload keyed by SectionKey. Both `draft` and
// `published` are stored as strings (JSON) and parsed on read via
// `sectionSchemaByKey[key]`. `sort` controls display order on the page.
// ------------------------------------------------------------------------

model Section {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key         String   // "hero" | "quickLinks" | "productGrid" | "whyUs" | "newsList"
  sort        Int      @default(0)
  draft       String   // JSON.stringify(parsed); current saved state (always present)
  published   String?  // JSON.stringify(parsed); null = never published
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SectionUpdater", fields: [updatedById], references: [id])

  @@unique([pageId, key])
  @@index([pageId, sort])
}

// ------------------------------------------------------------------------
// MediaAsset — uploaded image with webp/avif variants.
// ------------------------------------------------------------------------

model MediaAsset {
  id           String         @id @default(cuid())
  storageKey   String         @unique  // GUID stem, no extension
  mimeType     String                    // detected via magic bytes
  width        Int
  height       Int
  sizeBytes    Int                       // original file size
  altText      String
  uploadedById String
  uploadedBy   User           @relation("MediaUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  variants     MediaVariant[]
  usedByPages  Page[]         @relation("PageOgImage")
  usedByNews   NewsArticle[]  @relation("NewsCover")

  @@index([uploadedById])
}

model MediaVariant {
  id           String      @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  format       MediaFormat
  width        Int
  height       Int
  sizeBytes    Int
  storageKey   String

  @@index([mediaAssetId])
}

// ------------------------------------------------------------------------
// NewsArticle — bank news / press releases.
// ------------------------------------------------------------------------

model NewsArticle {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  excerpt     String
  body        String      // markdown
  coverId     String?
  cover       MediaAsset? @relation("NewsCover", fields: [coverId], references: [id])
  status      NewsStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  authorId    String
  author      User        @relation("NewsAuthor", fields: [authorId], references: [id])

  @@index([status, publishedAt])
}

// ------------------------------------------------------------------------
// AuditLog — append-only. Every mutating action records
// (actor, action, entityType, entityId, before, after).
// ------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("AuditActor", fields: [userId], references: [id])
  action     String   // "DRAFT_SAVE" | "PAGE_PUBLISH" | "MEDIA_UPLOAD" | ...
  entityType String   // "Section" | "Page" | "MediaAsset" | ...
  entityId   String
  before     String?  // JSON
  after      String?  // JSON
  at         DateTime @default(now())

  @@index([at])
  @@index([userId])
  @@index([entityType, entityId])
}